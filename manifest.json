{
  "id":"/",
  "name":"Paper Reader",
  "short_name":"Paper",
  "description":"Lector local de PDFs: lee, anota, estudia y consulta con IA privada",
  "start_url":"/",
  "display":"standalone",
  "background_color":"#2440b3",
  "theme_color":"#ffffff",
  "icons":[
    {"src":"/icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any"},
    {"src":"/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"/icon-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}
  ],
  "file_handlers":[
    {"action":"/","accept":{"application/pdf":[".pdf"],"text/markdown":[".md",".markdown"]}}
  ],
  "launch_handler":{"client_mode":"focus-existing"},
  "share_target":{
    "action":"/share-target",
    "method":"POST",
    "enctype":"multipart/form-data",
    "params":{"title":"title","text":"text","url":"url","files":[{"name":"files","accept":["application/pdf",".pdf","text/markdown",".md",".markdown"]}]}
  }
}
